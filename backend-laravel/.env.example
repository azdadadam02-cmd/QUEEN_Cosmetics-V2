APP_NAME="QUEEN Cosmetics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Casablanca

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Adresse du site Next.js (CORS)
FRONTEND_URL=http://localhost:3000

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Base de données MySQL (XAMPP) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queen_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Durée de vie d'un token de connexion (minutes) — 8 h comme avant
SANCTUM_EXPIRATION=480

# Mot de passe des comptes de test créés par « php artisan db:seed » (vide = aléatoire, affiché une fois)
SEED_PASSWORD=
